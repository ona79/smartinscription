# ==============================================================================
# SmartInscription IA - Environment Variables Example
# Copy this file to .env (and apps/web/.env.local if needed) and fill in values.
# NEVER commit .env files or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Fournisseur de paiement (Phase 1)
# ------------------------------------------------------------------------------
# Choix du fournisseur actif : "mock" (développement) ou "paytech" (sandbox/prod)
PAYMENT_PROVIDER="mock"
MOCK_WEBHOOK_SECRET="smartinscription-dev-mock-secret"

# PayTech Sénégal (laisser vide si PAYMENT_PROVIDER="mock")
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""
PAYTECH_ENV="test"

# ------------------------------------------------------------------------------
# Notifications Email (Phase 2)
# ------------------------------------------------------------------------------
# Laisser vide pour utiliser MockEmailProvider (logs console)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SmartInscription IA <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Seed & Comptes de test (Développement uniquement)
# ------------------------------------------------------------------------------
# En production, le seed est bloqué sauf si SEED_ALLOW_PROD="true"
SEED_ALLOW_PROD="false"
SEED_ADMIN_PASSWORD=""
SEED_AGENT_PASSWORD=""
SEED_STUDENT_PASSWORD=""

# Aide comptes de test sur /connexion (ignorée en production)
ENABLE_TEST_ACCOUNTS="false"
TEST_ACCOUNTS_PASSCODE=""

# ------------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Pooled connection string (Supavisor transaction mode on port 6543 in Supabase)
# For local Docker PostgreSQL dev:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartinscription"
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection string (port 5432) used by Prisma CLI for migrations
# For local Docker PostgreSQL dev:
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartinscription"
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase Auth & Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
# Server-only service role key (used for admin user creation & privileged ops)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# ------------------------------------------------------------------------------
# IA Service (FastAPI)
# ------------------------------------------------------------------------------
IA_SERVICE_URL="http://localhost:8000"
NEXT_PUBLIC_IA_SERVICE_URL="http://localhost:8000"
# Délai maximal (ms) d'un appel au service IA avant abandon (10 000 ms par défaut)
IA_TIMEOUT_MS="10000"

# ------------------------------------------------------------------------------
# Payment Providers (Leave empty for Phase 0; fill when implementing payments)
# ------------------------------------------------------------------------------
# Orange Money Senegal
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_MERCHANT_CODE=""
ORANGE_MONEY_WEBHOOK_SECRET=""

# Wave
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""

# Free Money
FREE_MONEY_API_KEY=""

# Wizall
WIZALL_API_KEY=""

# Card / Bank Gateway (e.g. Stripe / PayDunya / CinetPay)
CARD_PAYMENT_SECRET_KEY=""
CARD_PAYMENT_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Données de démonstration (seed-demo)
# ------------------------------------------------------------------------------
# Mot de passe utilisé pour les comptes synthétiques demo.<n>@smartinscription.sn
SEED_DEMO_PASSWORD="DemoPass2026!"
# Sécurité : le seed de démo refuse NODE_ENV=production sauf si SEED_ALLOW_PROD="true"
SEED_ALLOW_PROD="false"
